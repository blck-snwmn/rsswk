{
	"name": "rsswk",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@12.18.0",
	"scripts": {
		"deploy": "cf deploy --mode production",
		"dev": "cf dev",
		"start": "cf dev",
		"test": "vitest run",
		"cf-typegen": "cf workers types",
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --deny-warnings . --fix",
		"fmt": "oxfmt --write src/ test/",
		"fmt:check": "oxfmt --check src/ test/",
		"spec:test": "quint test spec/rsswk.qnt",
		"spec:verify:loss": "quint verify spec/rsswk.qnt --invariant=noLoss",
		"spec:verify:dup": "quint verify spec/rsswk.qnt --invariant=noDupUnlessFailed"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.4.12",
		"@informalsystems/quint": "0.33.1",
		"@types/node": "26.6.6",
		"cf": "1.0.0-beta.28",
		"oxfmt": "0.76.0",
		"oxlint": "1.91.0",
		"oxlint-tsgolint": "7.0.2005",
		"rollup": "4.65.1",
		"typescript": "7.0.2",
		"vitest": "5.0.5",
		"wrangler": "4.158.0"
	},
	"dependencies": {
		"fast-xml-parser": "5.11.2",
		"robots-parser": "3.0.1"
	},
	"type": "module"
}
